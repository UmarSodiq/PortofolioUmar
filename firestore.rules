rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Siapapun (pengunjung umum) dapat membaca konten portofolio
    // Hanya Admin yang terautentikasi (login) yang dapat membuat, mengubah, atau menghapus data
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
